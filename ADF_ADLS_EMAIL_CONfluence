def md_escape(s):
    """Names go into markdown button labels; keep _ * [ ] etc. literal."""
    return re.sub(r"([\\`*_\[\]~$:<>])", r"\\\1", s)


def crumb_label(x):
    lbl = x["label"] if len(x["label"]) <= 30 else x["label"][:29] + "…"
    return f"{x.get('icon', '')} {md_escape(lbl)}".strip()


def search_box(key, placeholder):
    try:
        return st.text_input(
            "Search", key=key, placeholder=placeholder, icon=":material/search:", label_visibility="collapsed"
        )
    except TypeError:  # older Streamlit without the icon argument
        return st.text_input("Search", key=key, placeholder=f"🔍 {placeholder}", label_visibility="collapsed")


def render_breadcrumb(c, path, file):
    """Azure-style path: Containers › 🗄️ container › 📁 folder › 📄 file. Wraps on deep trees."""
    crumbs = [{"label": "Containers", "c": "", "p": "", "icon": ""}]
    if c:
        crumbs.append({"label": c, "c": c, "p": "", "icon": "🗄️"})
        acc = ""
        for seg in [s for s in path.split("/") if s]:
            acc = f"{acc}/{seg}" if acc else seg
            crumbs.append({"label": seg, "c": c, "p": acc, "icon": "📁"})
        if file:
            crumbs.append({"label": basename(file), "c": c, "p": path, "icon": "📄"})

    hidden = []
    if len(crumbs) > 5:  # keep first two and last two, tuck the middle into a "…" menu
        hidden = crumbs[2:-2]
        crumbs = crumbs[:2] + [{"hidden": True}] + crumbs[-2:]
    last = len(crumbs) - 1

    with st.container(key="crumbbar"):
        cols = st.columns(2 * len(crumbs) - 1, gap="small")
        for i, x in enumerate(crumbs):
            col = cols[2 * i]
            if x.get("hidden"):
                with col.popover("…"):
                    for j, h in enumerate(hidden):
                        st.button(
                            crumb_label(h),
                            key=f"crumbh|{j}",
                            on_click=nav_set,
                            args=(h["c"], h["p"], None),
                            use_container_width=True,
                        )
            else:
                col.button(
                    crumb_label(x),
                    key=f"crumb|{i}",
                    on_click=nav_set,
                    args=(x["c"], x["p"], None),
                    disabled=(i == last),
                    help=x["label"] if len(x["label"]) > 30 else None,
                )
            if i < last:
                cols[2 * i + 1].markdown("›")


def render_entries(entries, key_prefix, empty_msg, parent=None):
    """Azure-style list: search by prefix, Name + Last modified, [..] row, pagination."""
    s1, s2 = st.columns([8, 1.3], vertical_alignment="center")
    with s1:
        q = search_box(f"flt|{key_prefix}", "Search by name prefix").strip()
    s2.button("🔄 Refresh", key=f"rf|{key_prefix}", on_click=refresh, use_container_width=True)

    if q:
        entries = [e for e in entries if e["label"].lower().startswith(q.lower())]

    total = len(entries)
    pages = max(1, math.ceil(total / PAGE_SIZE))
    page = 1
    if pages > 1:
        p1, p2 = st.columns([1, 5], vertical_alignment="center")
        page = p1.number_input("Page", 1, pages, 1, key=f"pg|{key_prefix}|{q}", label_visibility="collapsed")
        start = (page - 1) * PAGE_SIZE
        p2.caption(f"Showing {start + 1:,}–{min(start + PAGE_SIZE, total):,} of {total:,} items")
    else:
        start = 0
        st.caption(f"Showing all {total:,} items")

    widths = [7, 3]
    with st.container(key="explorer_list"):
        h = st.columns(widths, vertical_alignment="center")
        h[0].markdown("**Name**")
        h[1].markdown("**Last modified (UTC)**")

        if parent and page == 1:
            r = st.columns(widths, vertical_alignment="center")
            r[0].button(
                "📁  \\[..\\]",
                key=f"{key_prefix}|[..]",
                on_click=nav_set,
                args=(parent[0], parent[1], None),
                use_container_width=True,
            )

        for e in entries[start : start + PAGE_SIZE]:
            r = st.columns(widths, vertical_alignment="center")
            r[0].button(
                f"{e['icon']}  {md_escape(e['label'])}",
                key=f"{key_prefix}|{e['name']}",
                on_click=e["cb"],
                args=(e["name"],),
                disabled=e.get("disabled", False),
                help=e["label"] if len(e["label"]) > 45 else None,
                use_container_width=True,
            )
            r[1].caption(e.get("modified", ""))

    if total == 0:
        st.info(empty_msg if not q else "Nothing matches that prefix.")


