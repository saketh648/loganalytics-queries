@st.cache_resource
def get_credential():
    log.info("Creating DefaultAzureCredential")
    return DefaultAzureCredential()


@st.cache_resource
def get_client(account_name: str):
    url = f"https://{account_name}.dfs.core.windows.net"
    log.info("Creating DataLakeServiceClient for %s", url)
    return DataLakeServiceClient(account_url=url, credential=get_credential())


def reset_connection():
    get_client.clear()
    get_credential.clear()
    list_dir.clear()
    load_preview.clear()
    log.info("Connection caches cleared")


# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------
def human_size(n):
    if n is None:
        return ""
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def basename(path):
    return path.rsplit("/", 1)[-1]


def decode_jwt(token):
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    return json.loads(base64.urlsafe_b64decode(payload))


def hint_for(ex):
    status = getattr(ex, "status_code", None)
    code = getattr(ex, "error_code", None)
    code_s = str(code) if code else ""

    if isinstance(ex, (CredentialUnavailableError, ClientAuthenticationError)):
        return (
            "Authentication failed before reaching storage. Open the Diagnostics tab "
            "and check the AZURE_* variables and token test."
        )
    if isinstance(ex, ServiceRequestError):
        return (
            "Could not reach the storage endpoint (DNS or network). If the account uses "
            "a private endpoint or firewall, check DNS resolution and network rules "
            "from the AKS pod. Diagnostics tab has a DNS check."
        )
    if status == 403 and "AuthorizationPermissionMismatch" in code_s:
        return (
            "The identity authenticated but has no data-plane role. Assign **Storage Blob "
            "Data Reader** (or Contributor) to the UMI on the storage account or "
            "container. Role changes can take several minutes to apply."
        )
    if status == 403:
        return (
            "Forbidden. Either the RBAC data role is missing, or the storage firewall / "
            "private endpoint is blocking this pod's network."
        )
    if status == 404 and ("FilesystemNotFound" in code_s or "ContainerNotFound" in code_s):
        return "Container not found. Check the container name (case-sensitive) and account."
    if status == 404:
        return (
            "Path not found. Paths are case-sensitive, relative to the container, and "
            "should have no leading slash (e.g. `raw/2026/09`)."
        )
    if status in (400, 409):
        return (
            "Bad request. Confirm the storage account has hierarchical namespace "
            "(ADLS Gen2) enabled, since the .dfs endpoint requires it."
        )
    return None


def show_error(ex, context):
    log.exception("%s", context)
    status = getattr(ex, "status_code", None)
    code = getattr(ex, "error_code", None)
    extra = " · ".join(str(x) for x in (status, code) if x)
    st.error(f"❌ {context}\n\n**{type(ex).__name__}**{' · ' + extra if extra else ''}")
    hint = hint_for(ex)
    if hint:
        st.info(f"💡 {hint}")
    with st.expander("Full error"):
        st.code(str(ex), language="text")


# ----------------------------------------------------------------------------
# Data access (cached so reruns don't re-hit storage)
# ----------------------------------------------------------------------------
@st.cache_data(ttl=30, show_spinner="Listing…")
def list_dir(_client, account, container, path):
    log.info("Listing %s/%s/%s", account, container, path)
    fs = _client.get_file_system_client(container)
    paths = fs.get_paths(path=path or None, recursive=False)
    items = []
    for p in itertools.islice(paths, MAX_LIST_ITEMS):
        items.append(
            {
                "name": p.name,
                "is_directory": bool(p.is_directory),
                "size": None if p.is_directory else p.content_length,
                "modified": p.last_modified,
            }
        )
    log.info("Listed %d items in %s/%s", len(items), container, path)
    return items


@st.cache_data(ttl=300, show_spinner="Loading preview…")
def load_preview(_client, account, container, path, rows, max_mb):
    log.info("Preview %s/%s/%s", account, container, path)
    fc = _client.get_file_system_client(container).get_file_client(path)
    size = fc.get_file_properties().size
    ext = path.lower().rsplit(".", 1)[-1] if "." in path else ""
    max_bytes = int(max_mb * 1024 * 1024)

    # Streamable text formats: only read the first chunk
    if ext in ("csv", "tsv", "txt", "log", "jsonl", "ndjson"):
        n = min(size, max_bytes)
        data = fc.download_file(offset=0, length=n).readall() if n > 0 else b""
        truncated = size > n
        if truncated and b"\n" in data:
            data = data[: data.rfind(b"\n")]
        note = f"{human_size(size)}" + (f" · read first {human_size(n)}" if truncated else "")
        if ext in ("txt", "log"):
            return {"kind": "text", "text": data.decode("utf-8", "replace")[:20000], "note": note}
        if ext in ("csv", "tsv"):
            df = pd.read_csv(io.BytesIO(data), nrows=rows, sep="\t" if ext == "tsv" else ",")
        else:
            df = pd.read_json(io.BytesIO(data), lines=True, nrows=rows)
        return {"kind": "df", "df": df, "note": note}

    # Formats that need the whole file
    if ext in ("parquet", "json"):
        if size > max_bytes:
            return {"kind": "too_large", "note": f"{human_size(size)} exceeds the {max_mb} MB limit"}
        data = fc.download_file().readall()
        if ext == "parquet":
            import pyarrow.parquet as pq

            pf = pq.ParquetFile(io.BytesIO(data))
            batch = next(pf.iter_batches(batch_size=rows), None)
            df = batch.to_pandas() if batch is not None else pd.DataFrame(columns=pf.schema_arrow.names)
            note = f"{pf.metadata.num_rows:,} rows · {pf.metadata.num_columns} columns · {human_size(size)}"
            return {"kind": "df", "df": df, "note": note}
        try:
            df = pd.read_json(io.BytesIO(data))
        except ValueError:
            df = pd.read_json(io.BytesIO(data), lines=True)
        return {"kind": "df", "df": df.head(rows), "note": human_size(size)}

    return {"kind": "unsupported", "note": f".{ext or '?'} files can't be previewed"}


# ----------------------------------------------------------------------------
# Session state + navigation callbacks
# ----------------------------------------------------------------------------
st.session_state.setdefault("account", os.environ.get("ADLS_ACCOUNT_NAME", ""))
st.session_state.setdefault("container", os.environ.get("ADLS_CONTAINER", "consumerspace"))
st.session_state.setdefault("path", "")
st.session_state.setdefault("path_box", "")


def go(path=""):
    p = (path or "").strip().strip("/")
    st.session_state.path = p
    st.session_state.path_box = p
    st.session_state.selected_file = None


def go_from_box():
    go(st.session_state.path_box)


def go_up():
    p = st.session_state.path
    go(p.rsplit("/", 1)[0] if "/" in p else "")


def refresh():
    list_dir.clear()
    load_preview.clear()


def discover_containers():
    st.session_state.pop("containers_error", None)
    try:
        client = get_client(st.session_state.account.strip())
        st.session_state.containers = [fs.name for fs in client.list_file_systems()]
        log.info("Discovered containers: %s", st.session_state.containers)
    except Exception as ex:
        log.exception("Container discovery failed")
        st.session_state.containers_error = ex


def pick_container():
    st.session_state.container = st.session_state.container_pick
    go("")


