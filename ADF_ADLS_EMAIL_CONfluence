def show_df(df):
    try:
        st.dataframe(df, use_container_width=True)
    except Exception:
        log.warning("Arrow rendering failed, falling back to string display")
        st.dataframe(df.astype(str), use_container_width=True)


def render_file(container, path):
    try:
        result = load_preview(client, ACCOUNT, container, path, rows, max_mb)
    except Exception as ex:
        show_error(ex, f"Could not load '{basename(path)}'")
        return

    kind = result["kind"]
    if kind == "df":
        df = result["df"]
        m1, m2, m3, m4 = st.columns(4)
        m1.metric("Size", human_size(result["size"]))
        m2.metric("Modified", result["modified"].strftime("%Y-%m-%d %H:%M") if result["modified"] else "—")
        m3.metric("Columns", f"{len(df.columns):,}")
        if result["total_rows"] is not None:
            m4.metric("Rows (total)", f"{result['total_rows']:,}")
        else:
            m4.metric("Rows (loaded)", f"{len(df):,}")
        if result.get("note"):
            st.caption(result["note"])

        t_data, t_schema, t_stats = st.tabs(["Data", "Schema", "Statistics"])
        with t_data:
            cols = st.multiselect("Columns", list(df.columns), default=list(df.columns))
            q = st.text_input("Filter rows", placeholder="text to find in any column", key=f"q|{path}")
            view = df[cols] if cols else df
            if q:
                mask = (
                    view.astype(str)
                    .apply(lambda s: s.str.contains(q, case=False, na=False, regex=False))
                    .any(axis=1)
                )
                view = view[mask]
            st.caption(f"Showing {len(view):,} of {len(df):,} loaded rows")
            show_df(view)
            st.download_button(
                "⬇️ Download shown rows (CSV)",
                data=view.to_csv(index=False).encode("utf-8"),
                file_name=f"{basename(path).rsplit('.', 1)[0]}_preview.csv",
                mime="text/csv",
            )
        with t_schema:
            st.dataframe(
                pd.DataFrame(
                    {
                        "Column": df.columns,
                        "Type": df.dtypes.astype(str).values,
                        "Nulls (loaded rows)": df.isna().sum().values,
                    }
                ),
                use_container_width=True,
                hide_index=True,
            )
        with t_stats:
            try:
                show_df(df.describe(include="all").T)
            except Exception as ex:
                st.info(f"Statistics unavailable: {ex}")
    elif kind == "text":
        st.caption(f"{human_size(result['size'])} {result.get('note', '')}")
        st.code(result["text"], language="text")
    elif kind == "too_large":
        st.warning(f"{result['note']}. Raise the limit under ⚙️ Options in the sidebar.")
    else:
        st.info(result.get("note", "Preview isn't supported for this file type."))


def render_folder(container, folder):
    try:
        items = list_dir(client, ACCOUNT, container, folder, False)
    except Exception as ex:
        show_error(ex, f"Could not list '{container}/{folder}'")
        return
    dirs = sorted((i for i in items if i["is_directory"]), key=lambda i: i["name"])
    files = sorted((i for i in items if not i["is_directory"]), key=lambda i: i["name"])
    st.caption(f"{len(dirs)} folders · {len(files)} files. Pick a file in the sidebar to view its data.")
    if not items:
        st.info("This folder is empty.")
        return
    rows_out = [{"": "📁", "Name": basename(d["name"]), "Size": "", "Modified": ""} for d in dirs]
    rows_out += [
        {
            "": "📄",
            "Name": basename(f["name"]),
            "Size": human_size(f["size"]),
            "Modified": f["modified"].strftime("%Y-%m-%d %H:%M") if f["modified"] else "",
        }
        for f in files
    ]
    st.dataframe(pd.DataFrame(rows_out), use_container_width=True, hide_index=True)


