{
  "name": "sync-one-kv-secret-to-akv",
  "properties": {
    "description": "Child pipeline: sync ONE KV v2 secret (all its keys) into AKV. Called once per secret from sync-kv-to-akv. One AKV secret per KV key, named <secret>-<key>. ADF has NO keys() function, so it loops over key_names_json (default [client_id, client_secret]). No nested IfCondition - if_new_or_updated alone checks key-exists AND new/updated. No Pipeline Return Value - parent does not use it.",
    "parameters": {
      "secret_name": {
        "type": "string"
      },
      "secret_data_json": {
        "type": "string"
      },
      "key_names_json": {
        "type": "string",
        "defaultValue": "[\"client_id\",\"client_secret\"]"
      },
      "version": {
        "type": "string"
      },
      "updated_time": {
        "type": "string"
      },
      "akv_url": {
        "type": "string",
        "defaultValue": "https://kv-cus-synpeacx-prod-01.vault.azure.net"
      },
      "akv_name_prefix": {
        "type": "string",
        "defaultValue": ""
      },
      "kv_mount": {
        "type": "string",
        "defaultValue": "secret"
      },
      "kv_path": {
        "type": "string",
        "defaultValue": "prod/moneymovement"
      }
    },
    "variables": {
      "changes": {
        "type": "Array"
      },
      "akv_name": {
        "type": "String"
      },
      "current_key": {
        "type": "String"
      },
      "current_value": {
        "type": "String"
      }
    },
    "activities": [
      {
        "name": "for_each_kv_key",
        "description": "Single ForEach in this pipeline. Items is json(key_names_json), NOT keys(). Sequential: variables are not safe in parallel.",
        "type": "ForEach",
        "dependsOn": [],
        "typeProperties": {
          "items": {
            "type": "Expression",
            "value": "@json(pipeline().parameters.key_names_json)"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "set_akv_name",
              "description": "AKV allows only letters, digits and -. Replace _ and . with -. e.g. digital_qualtrics + client_id = digital-qualtrics-client-id",
              "type": "SetVariable",
              "dependsOn": [],
              "typeProperties": {
                "variableName": "akv_name",
                "value": {
                  "type": "Expression",
                  "value": "@concat(pipeline().parameters.akv_name_prefix, replace(replace(pipeline().parameters.secret_name,'_','-'),'.','-'), '-', replace(replace(item(),'_','-'),'.','-'))"
                }
              }
            },
            {
              "name": "set_current_key",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "set_akv_name",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "current_key",
                "value": {
                  "type": "Expression",
                  "value": "@item()"
                }
              }
            },
            {
              "name": "set_current_value",
              "description": "coalesce to empty string if this key is missing in the secret, so this step never fails",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "set_current_key",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "current_value",
                "value": {
                  "type": "Expression",
                  "value": "@string(coalesce(json(pipeline().parameters.secret_data_json)[variables('current_key')], ''))"
                }
              }
            },
            {
              "name": "get_akv_secret",
              "description": "404 means the secret does not exist yet. Failure is handled by the next activity.",
              "type": "WebActivity",
              "dependsOn": [
                {
                  "activity": "set_current_value",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": true,
                "secureInput": false
              },
              "typeProperties": {
                "method": "GET",
                "url": {
                  "type": "Expression",
                  "value": "@{pipeline().parameters.akv_url}/secrets/@{variables('akv_name')}?api-version=7.4"
                },
                "connectVia": {
                  "referenceName": "adfselfhostexcldir-special-projects",
                  "type": "IntegrationRuntimeReference"
                },
                "authentication": {
                  "type": "MSI",
                  "resource": "https://vault.azure.net"
                }
              }
            },
            {
              "name": "if_new_or_updated",
              "description": "Single IfCondition only - ADF does NOT allow an If inside an If. This one checks BOTH: key exists in the secret AND (missing in AKV OR version differs).",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "get_akv_secret",
                  "dependencyConditions": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "type": "Expression",
                  "value": "@and(contains(pipeline().parameters.secret_data_json, concat('\"', variables('current_key'), '\":')), or(equals(activity('get_akv_secret').Status,'Failed'), not(equals(string(coalesce(activity('get_akv_secret').output?.tags?.vault_version,'')), pipeline().parameters.version))))"
                },
                "ifTrueActivities": [
                  {
                    "name": "put_akv_secret",
                    "description": "Each PUT creates a new AKV secret version. Value is only this one KV key's value.",
                    "type": "WebActivity",
                    "dependsOn": [],
                    "policy": {
                      "timeout": "0.00:05:00",
                      "retry": 2,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": true,
                      "secureInput": true
                    },
                    "typeProperties": {
                      "method": "PUT",
                      "url": {
                        "type": "Expression",
                        "value": "@{pipeline().parameters.akv_url}/secrets/@{variables('akv_name')}?api-version=7.4"
                      },
                      "connectVia": {
                        "referenceName": "adfselfhostexcldir-special-projects",
                        "type": "IntegrationRuntimeReference"
                      },
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "value": "@{variables('current_value')}",
                        "contentType": "application/json",
                        "tags": {
                          "kv_key": "@{variables('current_key')}",
                          "synced_by": "adf-sync-kv-to-akv",
                          "vault_path": "@{concat(pipeline().parameters.kv_mount,'/',pipeline().parameters.kv_path,'/',pipeline().parameters.secret_name)}",
                          "vault_updated": "@{pipeline().parameters.updated_time}",
                          "vault_version": "@{pipeline().parameters.version}"
                        }
                      },
                      "authentication": {
                        "type": "MSI",
                        "resource": "https://vault.azure.net"
                      }
                    }
                  },
                  {
                    "name": "append_change",
                    "description": "Names, paths and version only, never values",
                    "type": "AppendVariable",
                    "dependsOn": [
                      {
                        "activity": "put_akv_secret",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "typeProperties": {
                      "variableName": "changes",
                      "value": {
                        "type": "Expression",
                        "value": "@json(concat('{\"name\":\"', variables('akv_name'), '\",\"path\":\"', pipeline().parameters.kv_mount, '/', pipeline().parameters.kv_path, '/', pipeline().parameters.secret_name, '\",\"key\":\"', variables('current_key'), '\",\"type\":\"', if(equals(activity('get_akv_secret').Status,'Failed'),'NEW','UPDATED'), '\",\"version\":\"', pipeline().parameters.version, '\"}'))"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}