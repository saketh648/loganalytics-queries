AzureDiagnostics
| where ResourceProvider == "MICROSOFT.DATAFACTORY"
| where Category == "ActivityRuns"
| where activityType_s in ("Copy", "ExecuteDataFlow")
| extend OutputObj = parse_json(Output_s)
| extend DataReadBytes = todouble(OutputObj.dataRead),
         DataWrittenBytes = todouble(OutputObj.dataWritten)
| summarize 
    TotalDataRead_GB = round(sum(DataReadBytes) / (1024 * 1024 * 1024), 2),
    TotalDataWritten_GB = round(sum(DataWrittenBytes) / (1024 * 1024 * 1024), 2),
    ActivityCount = count()
    by bin(TimeGenerated, 1d)
| order by TimeGenerated desc
