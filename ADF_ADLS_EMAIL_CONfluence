# Header + connection settings
# ----------------------------------------------------------------------------
st.title("📦 ADLS Gen2 Explorer")

configured = bool(st.session_state.account.strip() and st.session_state.container.strip())
with st.expander("⚙️ Connection", expanded=not configured):
    st.text_input("Storage account name", key="account", help="Just the name, not the URL")
    st.text_input("Container", key="container", on_change=go, args=("",))

    st.button("🔍 Find containers", on_click=discover_containers)
    if st.session_state.get("containers_error"):
        show_error(st.session_state.containers_error, "Could not list containers")
    if st.session_state.get("containers"):
        st.selectbox(
            "Discovered containers",
            st.session_state.containers,
            key="container_pick",
            index=None,
            placeholder="Pick one",
            on_change=pick_container,
        )

    c1, c2 = st.columns(2)
    rows = c1.slider("Preview rows", 10, 1000, 100, step=10)
    max_mb = c2.slider("Max preview size (MB)", 1, 200, 25)
    st.button("♻️ Reset connection", on_click=reset_connection)

account = st.session_state.account.strip()
container = st.session_state.container.strip()

if not account or not container:
    st.warning("Enter a storage account and container above to get started.")
    st.stop()

st.caption(f"`{account}` / `{container}` / `{st.session_state.path or '·'}`")

try:
    client = get_client(account)
except Exception as ex:
    show_error(ex, "Could not create storage client")
    st.stop()

tab_browse, tab_diag, tab_logs = st.tabs(["📂 Browse", "🩺 Diagnostics", "📜 Logs"])

# ----------------------------------------------------------------------------
# Browse
# ----------------------------------------------------------------------------
with tab_browse:
    st.text_input(
        "Folder path",
        key="path_box",
        on_change=go_from_box,
        placeholder="blank = container root, e.g. raw/2026/09",
    )
    b1, b2, b3 = st.columns(3)
    b1.button("🏠 Root", on_click=go, use_container_width=True)
    b2.button("⬆️ Up", on_click=go_up, disabled=not st.session_state.path, use_container_width=True)
    b3.button("🔄 Refresh", on_click=refresh, use_container_width=True)

    items = None
    try:
        items = list_dir(client, account, container, st.session_state.path)
    except Exception as ex:
        show_error(ex, f"Could not list '{container}/{st.session_state.path}'")

    if items is not None:
        dirs = [i for i in items if i["is_directory"]]
        files = [i for i in items if not i["is_directory"]]
        msg = f"{len(dirs)} folders · {len(files)} files"
        if len(items) >= MAX_LIST_ITEMS:
            msg += f" (showing first {MAX_LIST_ITEMS})"
        st.caption(msg)

        if not items:
            st.info("This folder is empty.")

        for d in dirs[:MAX_FOLDER_BUTTONS]:
            st.button(
                f"📁 {basename(d['name'])}",
                key=f"dir:{d['name']}",
                on_click=go,
                args=(d["name"],),
                use_container_width=True,
            )
        if len(dirs) > MAX_FOLDER_BUTTONS:
            st.caption(f"+{len(dirs) - MAX_FOLDER_BUTTONS} more folders. Type the path above to jump.")

        if files:
            st.dataframe(
                pd.DataFrame(
                    {
                        "File": [basename(f["name"]) for f in files],
                        "Size": [human_size(f["size"]) for f in files],
                        "Modified": [
                            f["modified"].strftime("%Y-%m-%d %H:%M") if f["modified"] else ""
                            for f in files
                        ],
                    }
                ),
                use_container_width=True,
                hide_index=True,
            )

            names = [f["name"] for f in files]
            if st.session_state.get("selected_file") not in names:
                st.session_state.selected_file = None
            selected = st.selectbox(
                "Preview a file",
                names,
                index=None,
                key="selected_file",
                format_func=basename,
                placeholder="Select a file",
            )

            if selected:
                st.subheader(basename(selected))
                try:
                    result = load_preview(client, account, container, selected, rows, max_mb)
                    if result.get("note"):
                        st.caption(result["note"])
                    kind = result["kind"]
                    if kind == "df":
                        st.dataframe(result["df"], use_container_width=True)
                    elif kind == "text":
                        st.code(result["text"], language="text")
                    elif kind == "too_large":
                        st.warning("File too large to preview. Raise the limit in ⚙️ Connection.")
                    else:
                        st.info("Preview isn't supported for this file type.")
                except Exception as ex:
                    show_error(ex, f"Could not preview '{basename(selected)}'")

# ----------------------------------------------------------------------------
# Diagnostics
# ----------------------------------------------------------------------------
with tab_diag:
    st.subheader("Workload identity environment")
    env_rows = []
    for k in ("AZURE_CLIENT_ID", "AZURE_TENANT_ID", "AZURE_FEDERATED_TOKEN_FILE", "AZURE_AUTHORITY_HOST"):
        v = os.environ.get(k)
        status = "✅" if v else "❌ missing"
        if k == "AZURE_FEDERATED_TOKEN_FILE" and v:
            status = "✅ file exists" if os.path.isfile(v) else "❌ file not found"
        env_rows.append({"Variable": k, "Value": v or "", "Status": status})
    st.dataframe(pd.DataFrame(env_rows), use_container_width=True, hide_index=True)

    if st.button("▶️ Run full connectivity test", type="primary"):
        results = []

        def step(name, fn):
            try:
                detail = fn()
                results.append(("✅", name, detail))
                log.info("Diag OK: %s | %s", name, detail)
                return True
            except Exception as ex:
                results.append(("❌", name, f"{type(ex).__name__}: {ex}"))
                log.exception("Diag FAILED: %s", name)
                return False

        def dns():
            host = f"{account}.dfs.core.windows.net"
            ips = sorted({r[4][0] for r in socket.getaddrinfo(host, 443)})
            return f"{host} → {', '.join(ips)}"

        def token():
            tok = get_credential().get_token(SCOPE)
            c = decode_jwt(tok.token)
            mins = int((tok.expires_on - datetime.now(timezone.utc).timestamp()) / 60)
            return (
                f"tenant={c.get('tid')} · principal (oid)={c.get('oid')} · "
                f"client={c.get('appid') or c.get('azp')} · expires in {mins} min"
            )

        def props():
            p = client.get_file_system_client(container).get_file_system_properties()
            return f"container '{container}' reachable (last modified {p.last_modified})"

        def listing():
            fs = client.get_file_system_client(container)
            first = list(itertools.islice(fs.get_paths(recursive=False), 5))
            return f"root listing OK, sample: {[p.name for p in first] or 'empty'}"

        step("1. DNS resolution", dns)
        if step("2. Acquire Entra token", token):
            if step("3. Read container properties", props):
                step("4. List container root", listing)

        for icon, name, detail in results:
            st.markdown(f"{icon} **{name}**")
            st.code(detail, language="text")

        if any(r[0] == "❌" for r in results):
            st.info(
                "The **principal (oid)** in step 2 is the object ID to assign the "
                "Storage Blob Data Reader role to. A private-endpoint account should "
                "resolve to a private IP in step 1."
            )

