def render_folder(c, path):
    try:
        items = list_dir(client, ACCOUNT, c, path, flat)
    except Exception as ex:
        show_error(ex, f"Could not list '{c}/{path}'")
        return

    prefix = f"{path}/" if path else ""
    dirs = [] if flat else sorted((i for i in items if i["is_directory"]), key=lambda i: i["name"])
    all_files = sorted((i for i in items if not i["is_directory"]), key=lambda i: i["name"])
    files = [f for f in all_files if ext_of(f["name"]) in FILE_TYPES] if data_only else all_files
    hidden = len(all_files) - len(files)

    entries = [
        {"icon": "📁", "label": basename(d["name"]), "name": d["name"], "cb": open_dir, "modified": fmt_dt(d["modified"])}
        for d in dirs
    ]
    for f in files:
        entries.append(
            {
                "icon": "📄",
                "label": f["name"][len(prefix):] if flat and f["name"].startswith(prefix) else basename(f["name"]),
                "name": f["name"],
                "cb": open_file,
                "modified": fmt_dt(f["modified"]),
                "disabled": ext_of(f["name"]) not in FILE_TYPES,
            }
        )

    if len(items) >= MAX_LIST_ITEMS:
        st.warning(f"Listing capped at {MAX_LIST_ITEMS:,} items. Use the search or open a deeper folder.")
    if hidden:
        st.caption(f"{hidden} non-data files hidden (change under ⚙️ Options).")

    render_entries(
        entries,
        f"{c}|{path}|{int(flat)}|{int(data_only)}",
        "This folder has no folders or data files.",
        parent=(c, parent_of(path)) if path else None,
    )


def render_file(c, path):
    """Data-first view: just the table, with everything else tucked in one collapsed panel."""
    try:
        result = load_preview(client, ACCOUNT, c, path, rows, max_mb)
    except Exception as ex:
        show_error(ex, f"Could not load '{basename(path)}'")
        return

    kind = result["kind"]
    if kind == "df":
        df = result["df"]
        total = result["total_rows"]
        summary = f"{total:,} rows · " if total is not None else ""
        summary += f"{len(df.columns):,} columns · showing first {len(df):,} rows"
        if result.get("note"):
            summary += f" · {result['note']}"
        st.caption(summary)

        with st.expander("Columns, filter & schema"):
            cols = st.multiselect("Columns", list(df.columns), default=list(df.columns))
            q = st.text_input("Filter rows", placeholder="text to find in any column", key=f"q|{path}")
            view = df[cols] if cols else df
            if q:
                mask = (
                    view.astype(str)
                    .apply(lambda s: s.str.contains(q, case=False, na=False, regex=False))
                    .any(axis=1)
                )
                view = view[mask]
            st.dataframe(
                pd.DataFrame(
                    {
                        "Column": df.columns,
                        "Type": df.dtypes.astype(str).values,
                        "Nulls": df.isna().sum().values,
                    }
                ),
                use_container_width=True,
                hide_index=True,
            )
            st.download_button(
                "⬇️ Download shown rows (CSV)",
                data=view.to_csv(index=False).encode("utf-8"),
                file_name=f"{basename(path).rsplit('.', 1)[0]}_preview.csv",
                mime="text/csv",
            )
            st.caption("Path")
            st.code(f"abfss://{c}@{ACCOUNT}.dfs.core.windows.net/{path}", language="text")

        show_df(view)
    elif kind == "text":
        st.code(result["text"], language="text")
    elif kind == "too_large":
        st.warning(f"{result['note']}. Raise the limit under ⚙️ Options in the sidebar.")
    else:
        st.info(result.get("note", "Preview isn't supported for this file type."))


