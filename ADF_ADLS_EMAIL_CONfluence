def nav_set(container="", path="", file=None):
    st.session_state.nav_container = container
    st.session_state.nav_path = path
    st.session_state.nav_file = file


def open_container(name):
    nav_set(name)


def open_dir(path):
    nav_set(st.session_state.nav_container, path)


def open_file(path):
    nav_set(st.session_state.nav_container, parent_of(path), path)


def open_from_box():
    name = st.session_state.get("open_box", "").strip()
    if name:
        nav_set(name)


def jump_to_path():
    st.session_state.jump_error = None
    raw = st.session_state.get("jump_box", "").strip()
    if not raw:
        return
    try:
        acct, cont, p = parse_path(raw, st.session_state.known_containers)
        if acct and acct.lower() != ACCOUNT.lower():
            raise ValueError(f"This app is locked to '{ACCOUNT}', but the path points to '{acct}'.")
        if not cont:
            raise ValueError("Could not find a container in that path.")
        if ext_of(p) in FILE_TYPES:
            nav_set(cont, parent_of(p), p)
        else:
            nav_set(cont, p, None)
        log.info("Jumped to %s/%s", cont, p)
    except ValueError as ex:
        st.session_state.jump_error = str(ex)


