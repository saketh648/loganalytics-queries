{
  "name": "sync-ldap-to-akv",
  "properties": {
    "description": "Sync HashiCorp Vault LDAP static roles (ldap/prod/us) into Azure Key Vault. Compares the role's last_vault_rotation with the last_vault_rotation tag on the AKV secret. Creates a new AKV version when a role is new or has rotated, and sends one digest email via Logic App.",
    "parameters": {
      "vault_url": { "type": "string", "defaultValue": "https://hcvault.yourcompany.com:8200" },
      "vault_namespace": { "type": "string", "defaultValue": "your/namespace" },
      "ldap_mount": { "type": "string", "defaultValue": "ldap/prod/us" },
      "akv_name_prefix": { "type": "string", "defaultValue": "" },
      "role_id": { "type": "string", "defaultValue": "<approle-role-id>" },
      "approle_secret_id_name": { "type": "string", "defaultValue": "hcv-approle-secret-id" },
      "akv_url": { "type": "string", "defaultValue": "https://kv-cus-synpeacx-prod-01.vault.azure.net" },
      "logic_app_url": { "type": "string", "defaultValue": "<logic-app-http-post-url>" },
      "send_email": { "type": "bool", "defaultValue": true }
    },
    "variables": {
      "changes": { "type": "Array" },
      "akv_name": { "type": "String" }
    },
    "activities": [
      {
        "name": "get_approle_secret_id",
        "description": "AppRole secret_id used to log in to Vault. Read from AKV so it is never stored in the pipeline.",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": { "timeout": "0.00:05:00", "retry": 1, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
        "typeProperties": {
          "url": {
            "value": "@{pipeline().parameters.akv_url}/secrets/@{pipeline().parameters.approle_secret_id_name}?api-version=7.4",
            "type": "Expression"
          },
          "method": "GET",
          "authentication": { "type": "MSI", "resource": "https://vault.azure.net" }
        }
      },
      {
        "name": "hashVaultLogin",
        "type": "WebActivity",
        "dependsOn": [ { "activity": "get_approle_secret_id", "dependencyConditions": [ "Succeeded" ] } ],
        "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
        "typeProperties": {
          "url": { "value": "@{pipeline().parameters.vault_url}/v1/auth/approle/login", "type": "Expression" },
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
          },
          "body": {
            "role_id": "@{pipeline().parameters.role_id}",
            "secret_id": "@{activity('get_approle_secret_id').output.value}"
          }
        }
      },
      {
        "name": "list_ldap_roles",
        "description": "List static roles. ADF Web has no LIST method, so use GET with ?list=true",
        "type": "WebActivity",
        "dependsOn": [ { "activity": "hashVaultLogin", "dependencyConditions": [ "Succeeded" ] } ],
        "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
        "typeProperties": {
          "url": {
            "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.ldap_mount}/static-role?list=true",
            "type": "Expression"
          },
          "method": "GET",
          "headers": {
            "X-Vault-Token": { "value": "@activity('hashVaultLogin').output.auth.client_token", "type": "Expression" },
            "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
          }
        }
      },
      {
        "name": "for_each_ldap_role",
        "description": "Sequential on purpose: Set variable (akv_name) is not safe in parallel.",
        "type": "ForEach",
        "dependsOn": [ { "activity": "list_ldap_roles", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "items": { "value": "@activity('list_ldap_roles').output.data.keys", "type": "Expression" },
          "isSequential": true,
          "activities": [
            {
              "name": "get_role_config",
              "description": "Role config only: username, dn, rotation_period, last_vault_rotation. No password.",
              "type": "WebActivity",
              "dependsOn": [],
              "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": true },
              "typeProperties": {
                "url": {
                  "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.ldap_mount}/static-role/@{item()}",
                  "type": "Expression"
                },
                "method": "GET",
                "headers": {
                  "X-Vault-Token": { "value": "@activity('hashVaultLogin').output.auth.client_token", "type": "Expression" },
                  "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
                }
              }
            },
            {
              "name": "set_akv_name",
              "description": "AKV name = optional prefix + role name with underscores replaced (AKV allows only letters, digits and -).",
              "type": "SetVariable",
              "dependsOn": [ { "activity": "get_role_config", "dependencyConditions": [ "Succeeded" ] } ],
              "typeProperties": {
                "variableName": "akv_name",
                "value": {
                  "value": "@concat(pipeline().parameters.akv_name_prefix, replace(replace(item(),'_','-'),'.','-'))",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "get_akv_secret",
              "description": "404 means the secret does not exist yet. Failure is handled by the next activity.",
              "type": "WebActivity",
              "dependsOn": [ { "activity": "set_akv_name", "dependencyConditions": [ "Succeeded" ] } ],
              "policy": { "timeout": "0.00:05:00", "retry": 0, "secureOutput": true, "secureInput": false },
              "typeProperties": {
                "url": {
                  "value": "@{pipeline().parameters.akv_url}/secrets/@{variables('akv_name')}?api-version=7.4",
                  "type": "Expression"
                },
                "method": "GET",
                "authentication": { "type": "MSI", "resource": "https://vault.azure.net" }
              }
            },
            {
              "name": "if_new_or_rotated",
              "description": "True when the secret is missing in AKV, or the role's last_vault_rotation differs from the tag stored in AKV.",
              "type": "IfCondition",
              "dependsOn": [ { "activity": "get_akv_secret", "dependencyConditions": [ "Succeeded", "Failed" ] } ],
              "typeProperties": {
                "expression": {
                  "value": "@or(equals(activity('get_akv_secret').Status,'Failed'), not(equals(string(coalesce(activity('get_akv_secret').output?.tags?.last_vault_rotation,'')), string(activity('get_role_config').output.data.last_vault_rotation))))",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "get_ldap_cred",
                    "description": "Reading static-cred does NOT rotate the password. It only returns the current one.",
                    "type": "WebActivity",
                    "dependsOn": [],
                    "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
                    "typeProperties": {
                      "url": {
                        "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.ldap_mount}/static-cred/@{item()}",
                        "type": "Expression"
                      },
                      "method": "GET",
                      "headers": {
                        "X-Vault-Token": { "value": "@activity('hashVaultLogin').output.auth.client_token", "type": "Expression" },
                        "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
                      }
                    }
                  },
                  {
                    "name": "put_akv_secret",
                    "description": "Each PUT creates a new AKV secret version. Value is the static-cred data as a JSON string (username, password, dn, last_password, ttl, last_vault_rotation).",
                    "type": "WebActivity",
                    "dependsOn": [ { "activity": "get_ldap_cred", "dependencyConditions": [ "Succeeded" ] } ],
                    "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
                    "typeProperties": {
                      "url": {
                        "value": "@{pipeline().parameters.akv_url}/secrets/@{variables('akv_name')}?api-version=7.4",
                        "type": "Expression"
                      },
                      "method": "PUT",
                      "headers": { "Content-Type": "application/json" },
                      "body": {
                        "value": "@{string(activity('get_ldap_cred').output.data)}",
                        "contentType": "application/json",
                        "tags": {
                          "last_vault_rotation": "@{activity('get_role_config').output.data.last_vault_rotation}",
                          "ldap_username": "@{activity('get_role_config').output.data.username}",
                          "vault_path": "@{pipeline().parameters.ldap_mount}/static-role/@{item()}",
                          "synced_by": "adf-sync-ldap-to-akv"
                        }
                      },
                      "authentication": { "type": "MSI", "resource": "https://vault.azure.net" }
                    }
                  },
                  {
                    "name": "append_change",
                    "description": "Names, paths and rotation time only, never values",
                    "type": "AppendVariable",
                    "dependsOn": [ { "activity": "put_akv_secret", "dependencyConditions": [ "Succeeded" ] } ],
                    "typeProperties": {
                      "variableName": "changes",
                      "value": {
                        "value": "@json(concat('{\"name\":\"', variables('akv_name'), '\",\"path\":\"', pipeline().parameters.ldap_mount, '/static-role/', item(), '\",\"type\":\"', if(equals(activity('get_akv_secret').Status,'Failed'),'NEW','ROTATED'), '\",\"version\":\"', string(activity('get_role_config').output.data.last_vault_rotation), '\"}'))",
                        "type": "Expression"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "filter_new",
        "type": "Filter",
        "dependsOn": [ { "activity": "for_each_ldap_role", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "items": { "value": "@variables('changes')", "type": "Expression" },
          "condition": { "value": "@equals(item().type,'NEW')", "type": "Expression" }
        }
      },
      {
        "name": "filter_rotated",
        "type": "Filter",
        "dependsOn": [ { "activity": "for_each_ldap_role", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "items": { "value": "@variables('changes')", "type": "Expression" },
          "condition": { "value": "@equals(item().type,'ROTATED')", "type": "Expression" }
        }
      },
      {
        "name": "if_has_changes",
        "type": "IfCondition",
        "dependsOn": [
          { "activity": "filter_new", "dependencyConditions": [ "Succeeded" ] },
          { "activity": "filter_rotated", "dependencyConditions": [ "Succeeded" ] }
        ],
        "typeProperties": {
          "expression": {
            "value": "@and(pipeline().parameters.send_email, greater(length(variables('changes')),0))",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "email_digest_logic_app",
              "type": "WebActivity",
              "dependsOn": [],
              "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
              "typeProperties": {
                "url": { "value": "@pipeline().parameters.logic_app_url", "type": "Expression" },
                "method": "POST",
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "subject": "@{concat('LDAP to AKV sync: ', string(length(activity('filter_new').output.Value)), ' new, ', string(length(activity('filter_rotated').output.Value)), ' rotated')}",
                  "pipeline": "@{pipeline().Pipeline}",
                  "runId": "@{pipeline().RunId}",
                  "timestamp": "@{utcnow()}",
                  "newCount": "@length(activity('filter_new').output.Value)",
                  "rotatedCount": "@length(activity('filter_rotated').output.Value)",
                  "newSecrets": "@activity('filter_new').output.Value",
                  "rotatedSecrets": "@activity('filter_rotated').output.Value"
                }
              }
            }
          ]
        }
      },
      {
        "name": "email_failure_logic_app",
        "description": "Alert when the loop fails",
        "type": "WebActivity",
        "dependsOn": [ { "activity": "for_each_ldap_role", "dependencyConditions": [ "Failed" ] } ],
        "policy": { "timeout": "0.00:05:00", "retry": 1, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "url": { "value": "@pipeline().parameters.logic_app_url", "type": "Expression" },
          "method": "POST",
          "headers": { "Content-Type": "application/json" },
          "body": {
            "subject": "FAILED: LDAP to AKV sync",
            "pipeline": "@{pipeline().Pipeline}",
            "runId": "@{pipeline().RunId}",
            "timestamp": "@{utcnow()}",
            "newCount": 0,
            "rotatedCount": 0,
            "newSecrets": [],
            "rotatedSecrets": []
          }
        }
      }
    ]
  }
}
