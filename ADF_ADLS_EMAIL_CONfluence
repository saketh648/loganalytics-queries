# ----------------------------------------------------------------------------
# Logging: stdout (kubectl logs) + in-app ring buffer (Logs tab)
# ----------------------------------------------------------------------------
class BufferHandler(logging.Handler):
    def __init__(self, buffer):
        super().__init__()
        self.buffer = buffer

    def emit(self, record):
        try:
            self.buffer.append(self.format(record))
        except Exception:
            self.handleError(record)


@st.cache_resource
def setup_logging():
    buffer = deque(maxlen=1000)
    fmt = logging.Formatter("%(asctime)s %(levelname)s %(name)s: %(message)s")
    stream = logging.StreamHandler(sys.stdout)
    stream.setFormatter(fmt)
    buf = BufferHandler(buffer)
    buf.setFormatter(fmt)

    app_logger = logging.getLogger("adls_reader")
    app_logger.setLevel(os.environ.get("LOG_LEVEL", "INFO").upper())
    app_logger.propagate = False
    app_logger.addHandler(stream)
    app_logger.addHandler(buf)

    for name, level in (("azure", logging.WARNING), ("azure.identity", logging.INFO)):
        lg = logging.getLogger(name)
        lg.setLevel(level)
        lg.addHandler(stream)
        lg.addHandler(buf)
    return app_logger, buffer


log, LOG_BUFFER = setup_logging()


# ----------------------------------------------------------------------------
# Errors
# ----------------------------------------------------------------------------
def err_info(ex):
    return {
        "type": type(ex).__name__,
        "status": getattr(ex, "status_code", None),
        "code": str(getattr(ex, "error_code", None) or ""),
        "message": str(ex),
    }


def hint_for(info):
    kind, status, code = info["type"], info["status"], info["code"]
    if kind in ("CredentialUnavailableError", "ClientAuthenticationError"):
        return (
            "Authentication failed before reaching storage. Check the AZURE_* variables "
            "and token test in the Diagnostics tab."
        )
    if kind == "ServiceRequestError":
        return (
            "Could not reach the storage endpoint (DNS or network). If the account uses a "
            "private endpoint or firewall, check name resolution and network rules from "
            "the pod. The Diagnostics tab has a DNS check."
        )
    if status == 403 and "AuthorizationPermissionMismatch" in code:
        return (
            "The identity authenticated but lacks a data-plane role. Assign **Storage Blob "
            "Data Reader** (or Contributor) to the UMI. Listing containers needs the role "
            "on the storage account; a role on one container only allows that container. "
            "Role changes can take several minutes."
        )
    if status == 403:
        return (
            "Forbidden. Either the data role is missing, or the storage firewall / private "
            "endpoint is blocking this pod."
        )
    if status == 404 and ("FilesystemNotFound" in code or "ContainerNotFound" in code):
        return "Container not found. Check the name (case-sensitive)."
    if status == 404:
        return "Path not found. Paths are case-sensitive, relative to the container, with no leading slash."
    if status in (400, 409):
        return "Bad request. Confirm the account has hierarchical namespace (ADLS Gen2) enabled."
    return None


def render_error(info, context):
    extra = " · ".join(str(x) for x in (info["status"], info["code"]) if x)
    st.error(f"❌ {context}\n\n**{info['type']}**{' · ' + extra if extra else ''}")
    hint = hint_for(info)
    if hint:
        st.info(f"💡 {hint}")
    with st.expander("Full error"):
        st.code(info["message"], language="text")


def show_error(ex, context):
    log.error("%s", context, exc_info=ex)
    render_error(err_info(ex), context)


