with tab_d:
    st.subheader("Workload identity environment")
    env_rows = []
    for k in ("ADLS_ACCOUNT_NAME", "AZURE_CLIENT_ID", "AZURE_TENANT_ID", "AZURE_FEDERATED_TOKEN_FILE", "AZURE_AUTHORITY_HOST"):
        v = os.environ.get(k)
        status = "✅" if v else "❌ missing"
        if k == "AZURE_FEDERATED_TOKEN_FILE" and v:
            status = "✅ file exists" if os.path.isfile(v) else "❌ file not found"
        env_rows.append({"Variable": k, "Value": v or "", "Status": status})
    st.dataframe(pd.DataFrame(env_rows), use_container_width=True, hide_index=True)

    if conn.get("error"):
        render_error(conn["error"], "Connection check reported a problem")

    diag_container = nav_c or DEFAULT_CONTAINER
    if st.button("▶️ Run full connectivity test", type="primary"):
        results = []

        def step(name, fn):
            try:
                detail = fn()
                results.append(("✅", name, detail))
                log.info("Diag OK: %s | %s", name, detail)
                return True
            except Exception as ex:
                results.append(("❌", name, f"{type(ex).__name__}: {ex}"))
                log.error("Diag FAILED: %s", name, exc_info=ex)
                return False

        def dns():
            host = f"{ACCOUNT}.dfs.core.windows.net"
            ips = sorted({r[4][0] for r in socket.getaddrinfo(host, 443)})
            return f"{host} → {', '.join(ips)}"

        def token():
            tok = get_credential().get_token(SCOPE)
            c = decode_jwt(tok.token)
            mins = int((tok.expires_on - datetime.now(timezone.utc).timestamp()) / 60)
            return (
                f"tenant={c.get('tid')} · principal (oid)={c.get('oid')} · "
                f"client={c.get('appid') or c.get('azp')} · expires in {mins} min"
            )

        def list_containers():
            names = [fs.name for fs in client.list_file_systems()]
            return f"{len(names)} containers visible: {names[:10]}"

        def props():
            p = client.get_file_system_client(diag_container).get_file_system_properties()
            return f"container '{diag_container}' reachable (last modified {p.last_modified})"

        def listing():
            fs = client.get_file_system_client(diag_container)
            first = list(itertools.islice(fs.get_paths(recursive=False), 5))
            return f"root listing OK, sample: {[p.name for p in first] or 'empty'}"

        step("1. DNS resolution", dns)
        if step("2. Acquire Entra token", token):
            step("3. List containers (needs account-level role)", list_containers)
            if diag_container:
                if step(f"4. Read container '{diag_container}'", props):
                    step("5. List container root", listing)
            else:
                results.append(("ℹ️", "4. Container checks", "Open a container in the Explorer first to test it."))

        for icon, name, detail in results:
            st.markdown(f"{icon} **{name}**")
            st.code(detail, language="text")

        if any(r[0] == "❌" for r in results):
            st.info(
                "The **principal (oid)** in step 2 is the object ID that needs the Storage Blob "
                "Data Reader role. A private-endpoint account should resolve to a private IP in step 1."
            )

