{
  "name": "pipeline_universal_email_sender",
  "properties": {
    "description": "Universal pipeline to read CSV, Parquet, or JSON as binary from ADLS Gen2 and email via Logic App",
    "parameters": {
      "FolderPath": {
        "type": "string",
        "defaultValue": "raw-data/reports"
      },
      "FileName": {
        "type": "string",
        "defaultValue": "sample_data.parquet"
      },
      "RecipientEmail": {
        "type": "string",
        "defaultValue": "user@example.com"
      },
      "LogicAppUrl": {
        "type": "string",
        "defaultValue": "https://prod-xx.eastus.logic.azure.com:443/workflows/..."
      }
    },
    "variables": {},
    "activities": [
      {
        "name": "Get_File_Binary_Content",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "url": "@concat('https://', 'YOUR_STORAGE_ACCOUNT', '.blob.core.windows.net/', pipeline().parameters.FolderPath, '/', pipeline().parameters.FileName)",
          "method": "GET",
          "headers": {
            "x-ms-version": "2020-10-02"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://storage.azure.net/"
          }
        }
      },
      {
        "name": "Trigger_Logic_App",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "Get_File_Binary_Content",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "url": "@pipeline().parameters.LogicAppUrl",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "fileName": "@pipeline().parameters.FileName",
            "fileContent": "@activity('Get_File_Binary_Content').output.payload",
            "recipientEmail": "@pipeline().parameters.RecipientEmail"
          }
        }
      }
    ],
    "annotations": []
  }
}
