{
  "name": "sync-hcv-to-akv",
  "properties": {
    "description": "Daily sync of HashiCorp Vault KV v2 secrets into Azure Key Vault. Compares Vault current_version with the vault_version tag on the AKV secret. Creates a new AKV version when new or rotated and sends one digest email via Logic App.",
    "parameters": {
      "vault_url": { "type": "string", "defaultValue": "https://hcvault.yourcompany.com:8200" },
      "vault_namespace": { "type": "string", "defaultValue": "your/namespace" },
      "vault_mount": { "type": "string", "defaultValue": "secret" },
      "vault_list_path": { "type": "string", "defaultValue": "" },
      "role_id": { "type": "string", "defaultValue": "<approle-role-id>" },
      "approle_secret_id_name": { "type": "string", "defaultValue": "hcv-approle-secret-id" },
      "akv_url": { "type": "string", "defaultValue": "https://kv-cus-synpeacx-prod-01.vault.azure.net" },
      "logic_app_url": { "type": "string", "defaultValue": "<logic-app-http-post-url>" }
    },
    "variables": {
      "changes": { "type": "Array" }
    },
    "activities": [
      {
        "name": "get_approle_secret_id",
        "description": "Read the AppRole secret_id from AKV so it is never stored in the pipeline.",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": { "timeout": "0.00:05:00", "retry": 1, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
        "typeProperties": {
          "url": {
            "value": "@{pipeline().parameters.akv_url}/secrets/@{pipeline().parameters.approle_secret_id_name}?api-version=7.4",
            "type": "Expression"
          },
          "method": "GET",
          "authentication": { "type": "MSI", "resource": "https://vault.azure.net" }
        }
      },
      {
        "name": "hashVaultLogin",
        "type": "WebActivity",
        "dependsOn": [ { "activity": "get_approle_secret_id", "dependencyConditions": [ "Succeeded" ] } ],
        "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
        "typeProperties": {
          "url": { "value": "@{pipeline().parameters.vault_url}/v1/auth/approle/login", "type": "Expression" },
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
          },
          "body": {
            "role_id": "@{pipeline().parameters.role_id}",
            "secret_id": "@{activity('get_approle_secret_id').output.value}"
          }
        }
      },
      {
        "name": "list_vault_secrets",
        "description": "ADF Web has no LIST method, so use GET with ?list=true",
        "type": "WebActivity",
        "dependsOn": [ { "activity": "hashVaultLogin", "dependencyConditions": [ "Succeeded" ] } ],
        "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
        "typeProperties": {
          "url": {
            "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.vault_mount}/metadata/@{pipeline().parameters.vault_list_path}?list=true",
            "type": "Expression"
          },
          "method": "GET",
          "headers": {
            "X-Vault-Token": { "value": "@activity('hashVaultLogin').output.auth.client_token", "type": "Expression" },
            "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
          }
        }
      },
      {
        "name": "filter_keys",
        "description": "Keep secrets only, drop sub-folders (keys ending with /)",
        "type": "Filter",
        "dependsOn": [ { "activity": "list_vault_secrets", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "items": { "value": "@activity('list_vault_secrets').output.data.keys", "type": "Expression" },
          "condition": { "value": "@not(endswith(item(),'/'))", "type": "Expression" }
        }
      },
      {
        "name": "for_each_vault_secret",
        "type": "ForEach",
        "dependsOn": [ { "activity": "filter_keys", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "items": { "value": "@activity('filter_keys').output.Value", "type": "Expression" },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "get_vault_metadata",
              "description": "Metadata only: current_version and updated_time. No secret value.",
              "type": "WebActivity",
              "dependsOn": [],
              "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": true },
              "typeProperties": {
                "url": {
                  "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.vault_mount}/metadata/@{pipeline().parameters.vault_list_path}@{item()}",
                  "type": "Expression"
                },
                "method": "GET",
                "headers": {
                  "X-Vault-Token": { "value": "@activity('hashVaultLogin').output.auth.client_token", "type": "Expression" },
                  "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
                }
              }
            },
            {
              "name": "get_akv_secret",
              "description": "404 means the secret does not exist yet. Failure is handled by the next activity.",
              "type": "WebActivity",
              "dependsOn": [ { "activity": "get_vault_metadata", "dependencyConditions": [ "Succeeded" ] } ],
              "policy": { "timeout": "0.00:05:00", "retry": 0, "secureOutput": true, "secureInput": false },
              "typeProperties": {
                "url": {
                  "value": "@{pipeline().parameters.akv_url}/secrets/@{replace(replace(item(),'/','-'),'_','-')}?api-version=7.4",
                  "type": "Expression"
                },
                "method": "GET",
                "authentication": { "type": "MSI", "resource": "https://vault.azure.net" }
              }
            },
            {
              "name": "if_new_or_rotated",
              "type": "IfCondition",
              "dependsOn": [ { "activity": "get_akv_secret", "dependencyConditions": [ "Succeeded", "Failed" ] } ],
              "typeProperties": {
                "expression": {
                  "value": "@or(equals(activity('get_akv_secret').Status,'Failed'), greater(int(activity('get_vault_metadata').output.data.current_version), int(coalesce(activity('get_akv_secret').output?.tags?.vault_version,'0'))))",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "get_vault_data",
                    "type": "WebActivity",
                    "dependsOn": [],
                    "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
                    "typeProperties": {
                      "url": {
                        "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.vault_mount}/data/@{pipeline().parameters.vault_list_path}@{item()}",
                        "type": "Expression"
                      },
                      "method": "GET",
                      "headers": {
                        "X-Vault-Token": { "value": "@activity('hashVaultLogin').output.auth.client_token", "type": "Expression" },
                        "X-Vault-Namespace": { "value": "@pipeline().parameters.vault_namespace", "type": "Expression" }
                      }
                    }
                  },
                  {
                    "name": "put_akv_secret",
                    "description": "Each PUT creates a new AKV secret version. Stores the whole Vault key/value map as a JSON string.",
                    "type": "WebActivity",
                    "dependsOn": [ { "activity": "get_vault_data", "dependencyConditions": [ "Succeeded" ] } ],
                    "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": true, "secureInput": true },
                    "typeProperties": {
                      "url": {
                        "value": "@{pipeline().parameters.akv_url}/secrets/@{replace(replace(item(),'/','-'),'_','-')}?api-version=7.4",
                        "type": "Expression"
                      },
                      "method": "PUT",
                      "headers": { "Content-Type": "application/json" },
                      "body": {
                        "value": "@{string(activity('get_vault_data').output.data.data)}",
                        "contentType": "application/json",
                        "tags": {
                          "vault_version": "@{string(activity('get_vault_metadata').output.data.current_version)}",
                          "vault_updated": "@{activity('get_vault_metadata').output.data.updated_time}",
                          "vault_path": "@{item()}",
                          "synced_by": "adf-sync-hcv-to-akv"
                        }
                      },
                      "authentication": { "type": "MSI", "resource": "https://vault.azure.net" }
                    }
                  },
                  {
                    "name": "append_change",
                    "description": "Names and versions only, never values",
                    "type": "AppendVariable",
                    "dependsOn": [ { "activity": "put_akv_secret", "dependencyConditions": [ "Succeeded" ] } ],
                    "typeProperties": {
                      "variableName": "changes",
                      "value": {
                        "value": "@json(concat('{\"name\":\"', replace(replace(item(),'/','-'),'_','-'), '\",\"type\":\"', if(equals(activity('get_akv_secret').Status,'Failed'),'NEW','ROTATED'), '\",\"version\":\"', string(activity('get_vault_metadata').output.data.current_version), '\"}'))",
                        "type": "Expression"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "filter_new",
        "type": "Filter",
        "dependsOn": [ { "activity": "for_each_vault_secret", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "items": { "value": "@variables('changes')", "type": "Expression" },
          "condition": { "value": "@equals(item().type,'NEW')", "type": "Expression" }
        }
      },
      {
        "name": "filter_rotated",
        "type": "Filter",
        "dependsOn": [ { "activity": "for_each_vault_secret", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "items": { "value": "@variables('changes')", "type": "Expression" },
          "condition": { "value": "@equals(item().type,'ROTATED')", "type": "Expression" }
        }
      },
      {
        "name": "if_has_changes",
        "type": "IfCondition",
        "dependsOn": [
          { "activity": "filter_new", "dependencyConditions": [ "Succeeded" ] },
          { "activity": "filter_rotated", "dependencyConditions": [ "Succeeded" ] }
        ],
        "typeProperties": {
          "expression": { "value": "@greater(length(variables('changes')),0)", "type": "Expression" },
          "ifTrueActivities": [
            {
              "name": "email_digest_logic_app",
              "type": "WebActivity",
              "dependsOn": [],
              "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
              "typeProperties": {
                "url": { "value": "@pipeline().parameters.logic_app_url", "type": "Expression" },
                "method": "POST",
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "subject": "@{concat('HCV to AKV sync: ', string(length(activity('filter_new').output.Value)), ' new, ', string(length(activity('filter_rotated').output.Value)), ' rotated')}",
                  "pipeline": "@{pipeline().Pipeline}",
                  "runId": "@{pipeline().RunId}",
                  "timestamp": "@{utcnow()}",
                  "newCount": "@length(activity('filter_new').output.Value)",
                  "rotatedCount": "@length(activity('filter_rotated').output.Value)",
                  "newSecrets": "@activity('filter_new').output.Value",
                  "rotatedSecrets": "@activity('filter_rotated').output.Value"
                }
              }
            }
          ]
        }
      },
      {
        "name": "email_failure_logic_app",
        "description": "Optional: alert when the loop fails",
        "type": "WebActivity",
        "dependsOn": [ { "activity": "for_each_vault_secret", "dependencyConditions": [ "Failed" ] } ],
        "policy": { "timeout": "0.00:05:00", "retry": 1, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "url": { "value": "@pipeline().parameters.logic_app_url", "type": "Expression" },
          "method": "POST",
          "headers": { "Content-Type": "application/json" },
          "body": {
            "subject": "FAILED: HCV to AKV sync",
            "pipeline": "@{pipeline().Pipeline}",
            "runId": "@{pipeline().RunId}",
            "timestamp": "@{utcnow()}",
            "newCount": 0,
            "rotatedCount": 0,
            "newSecrets": [],
            "rotatedSecrets": []
          }
        }
      }
    ]
  }
}
