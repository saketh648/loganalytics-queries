@st.cache_resource
def get_credential():
    log.info("Creating DefaultAzureCredential")
    return DefaultAzureCredential()


@st.cache_resource
def get_client(account_name: str):
    url = f"https://{account_name}.dfs.core.windows.net"
    log.info("Creating DataLakeServiceClient for %s", url)
    return DataLakeServiceClient(account_url=url, credential=get_credential())


@st.cache_data(ttl=60, show_spinner="Connecting to storage…")
def check_connection(_client, account):
    info = {"state": "failed", "containers": [], "modified": {}, "error": None}
    try:
        get_credential().get_token(SCOPE)
    except Exception as ex:
        log.error("Token acquisition failed", exc_info=ex)
        info["error"] = err_info(ex)
        return info
    try:
        fss = list(_client.list_file_systems())
        names = sorted(fs.name for fs in fss)
        info.update(state="connected", containers=names, modified={fs.name: fs.last_modified for fs in fss})
        log.info("Connected. %d containers visible", len(names))
    except Exception as ex:
        log.warning("Token OK but listing containers failed: %s", ex)
        info.update(state="limited", error=err_info(ex))
    return info


def refresh():
    list_dir.clear()
    load_preview.clear()
    check_connection.clear()


def reconnect():
    refresh()
    check_connection.clear()
    get_client.clear()
    get_credential.clear()
    log.info("Connection caches cleared")


