def human_size(n):
    if n is None:
        return ""
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def basename(path):
    return path.rsplit("/", 1)[-1]


def parent_of(path):
    return path.rsplit("/", 1)[0] if "/" in path else ""


def ext_of(name):
    return name.lower().rsplit(".", 1)[-1] if "." in name else ""


def decode_jwt(token):
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    return json.loads(base64.urlsafe_b64decode(payload))


def parse_path(raw, known_containers):
    """Accepts abfss://c@acct.dfs.core.windows.net/p, https://acct.dfs.../c/p, or c/p."""
    s = raw.strip().strip("\"'")
    low = s.lower()
    acct = None
    if low.startswith(("abfss://", "abfs://")):
        rest = s.split("://", 1)[1]
        cont, sep, after = rest.partition("@")
        if not sep:
            raise ValueError("Expected abfss://<container>@<account>.dfs.core.windows.net/<path>")
        host, _, path = after.partition("/")
        acct = host.split(".")[0]
    elif low.startswith(("https://", "http://")):
        u = urlparse(s)
        acct = (u.hostname or "").split(".")[0]
        cont, _, path = u.path.lstrip("/").partition("/")
    else:
        s = s.lstrip("/")
        first, _, rest = s.partition("/")
        if first in known_containers or first == DEFAULT_CONTAINER or not DEFAULT_CONTAINER:
            cont, path = first, rest
        else:
            cont, path = DEFAULT_CONTAINER, s
    return acct, unquote(cont), unquote(path).strip("/")


