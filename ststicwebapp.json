def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    # 1. Existing metrics table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS metrics (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            category TEXT NOT NULL,
            value INTEGER NOT NULL,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')

    # 2. Existing users table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL
        )
    ''')

    # 3. NEW: Active Sessions Table (Tracks logins, last active time, and logouts)
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS user_sessions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            login_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            last_activity TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            logout_time TIMESTAMP NULL
        )
    ''')

    # 4. NEW: Audit Logs Table (Tracks specific actions performed)
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS audit_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            action TEXT NOT NULL,
            endpoint TEXT NOT NULL,
            timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')

    # Seed default user if empty
    cursor.execute('SELECT COUNT(*) FROM users')
    if cursor.fetchone()[0] == 0:
        cursor.execute('INSERT INTO users (username, password_hash) VALUES (?, ?)', 
                       ('admin', hash_password('adminpassword')))
        print("Created default user: admin / adminpassword", flush=True)

    # Seed initial metrics if empty
    cursor.execute('SELECT COUNT(*) FROM metrics')
    if cursor.fetchone()[0] == 0:
        sample_data = [('Sales', 120), ('Marketing', 85), ('Engineering', 150), ('Support', 65)]
        cursor.executemany('INSERT INTO metrics (category, value) VALUES (?, ?)', sample_data)

    conn.commit()
    conn.close()





import sqlite3

DB_NAME = "dashboard.db"

def show_audit_report():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    print("\n--- USER SESSIONS & DURATION ---")
    cursor.execute('''
        SELECT 
            username,
            login_time,
            last_activity,
            ROUND((JULIANDAY(last_activity) - JULIANDAY(login_time)) * 86400, 2) AS duration_seconds
        FROM user_sessions
        ORDER BY login_time DESC
    ''')
    sessions = cursor.fetchall()
    
    for row in sessions:
        print(f"User: {row[0]} | Logged In: {row[1]} | Last Active: {row[2]} | Duration: {row[3]} seconds")

    print("\n--- RECENT AUDIT LOGS ---")
    cursor.execute('''
        SELECT username, action, endpoint, timestamp 
        FROM audit_logs 
        ORDER BY timestamp DESC LIMIT 10
    ''')
    logs = cursor.fetchall()
    
    for log in logs:
        print(f"[{log[3]}] User: {log[0]} | Action: {log[1]} ({log[2]})")

    conn.close()

if __name__ == '__main__':
    show_audit_report()
