class AuthenticatedDashboardHandler(SimpleHTTPRequestHandler):

    def authenticate(self):
        auth_header = self.headers.get('Authorization')
        if not auth_header:
            return None

        try:
            auth_type, encoded = auth_header.split(' ', 1)
            if auth_type.lower() != 'basic':
                return None

            decoded = base64.b64decode(encoded).decode('utf-8')
            username, password = decoded.split(':', 1)

            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            cursor.execute('SELECT password_hash FROM users WHERE username = ?', (username,))
            row = cursor.fetchone()
            conn.close()

            if row and row[0] == hash_password(password):
                return username  # Return username if authentication succeeds
        except Exception:
            return None

        return None

    def log_activity(self, username, action, endpoint):
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()

        # 1. Log specific action in audit_logs
        cursor.execute(
            'INSERT INTO audit_logs (username, action, endpoint) VALUES (?, ?, ?)',
            (username, action, endpoint)
        )

        # 2. Check if user has an open session record, or create a new one
        cursor.execute('''
            SELECT id FROM user_sessions 
            WHERE username = ? AND logout_time IS NULL 
            ORDER BY login_time DESC LIMIT 1
        ''', (username,))
        session = cursor.fetchone()

        if session:
            # Update last_activity timestamp to calculate duration later
            cursor.execute('''
                UPDATE user_sessions 
                SET last_activity = CURRENT_TIMESTAMP 
                WHERE id = ?
            ''', (session[0],))
        else:
            # First time logging in during this session
            cursor.execute(
                'INSERT INTO user_sessions (username) VALUES (?)',
                (username,)
            )

        conn.commit()
        conn.close()

    def do_GET(self):
        username = self.authenticate()
        if not username:
            self.send_auth_prompt()
            return

        # Track the action in audit_logs
        if self.path == '/api/metrics':
            self.log_activity(username, "FETCH_METRICS", self.path)
            
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()

            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            cursor.execute('SELECT category, value, updated_at FROM metrics')
            rows = cursor.fetchall()
            conn.close()

            data = [{"category": row[0], "value": row[1], "updated_at": row[2]} for row in rows]
            response = {"timestamp": datetime.now().strftime("%I:%M:%S %p"), "data": data}
            self.wfile.write(json.dumps(response).encode('utf-8'))
        else:
            if self.path == '/' or self.path == '/index.html':
                self.log_activity(username, "VIEW_DASHBOARD_PAGE", self.path)
                self.path = '/index.html'
            return super().do_GET()

    def do_POST(self):
        username = self.authenticate()
        if not username:
            self.send_auth_prompt()
            return

        if self.path == '/api/simulate-update':
            self.log_activity(username, "SIMULATE_DB_UPDATE", self.path)

            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            cursor.execute('SELECT id, value FROM metrics')
            rows = cursor.fetchall()

            for row in rows:
                random_change = random.randint(-10, 20)
                new_val = max(10, row[1] + random_change)
                cursor.execute('UPDATE metrics SET value = ? WHERE id = ?', (new_val, row[0]))

            conn.commit()
            conn.close()

            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({"status": "success"}).encode('utf-8'))
