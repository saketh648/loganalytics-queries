import sqlite3
import random
import json
import os
from http.server import HTTPServer, SimpleHTTPRequestHandler
from datetime import datetime

DB_NAME = "dashboard.db"

# 1. Initialize SQLite Database (Built-in)
def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS metrics (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            category TEXT NOT NULL,
            value INTEGER NOT NULL,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    cursor.execute('SELECT COUNT(*) as count FROM metrics')
    if cursor.fetchone()[0] == 0:
        sample_data = [
            ('Sales', 120),
            ('Marketing', 85),
            ('Engineering', 150),
            ('Support', 65)
        ]
        cursor.executemany('INSERT INTO metrics (category, value) VALUES (?, ?)', sample_data)
        conn.commit()
        print("Sample database created successfully!")
    conn.close()

# 2. Custom HTTP Handler using Python's built-in http.server
class DashboardRequestHandler(SimpleHTTPRequestHandler):
    
    # Handle GET requests (Serving HTML & API endpoints)
    def do_GET(self):
        if self.path == '/api/metrics':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            
            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            cursor.execute('SELECT category, value, updated_at FROM metrics')
            rows = cursor.fetchall()
            conn.close()
            
            data = [{"category": row[0], "value": row[1], "updated_at": row[2]} for row in rows]
            response = {
                "timestamp": datetime.now().strftime("%I:%M:%S %p"),
                "data": data
            }
            self.wfile.write(json.dumps(response).encode('utf-8'))
        else:
            # Serve regular static HTML file
            if self.path == '/':
                self.path = '/index.html'
            return super().do_GET()

    # Handle POST requests (Simulating database updates)
    def do_POST(self):
        if self.path == '/api/simulate-update':
            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            cursor.execute('SELECT id, value FROM metrics')
            rows = cursor.fetchall()
            
            for row in rows:
                random_change = random.randint(-10, 20)
                new_val = max(10, row[1] + random_change)
                cursor.execute('UPDATE metrics SET value = ? WHERE id = ?', (new_val, row[0]))
            
            conn.commit()
            conn.close()
            
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({"status": "success"}).encode('utf-8'))

if __name__ == '__main__':
    init_db()
    server_address = ('', 8000)
    httpd = HTTPServer(server_address, DashboardRequestHandler)
    print("Server running at http://localhost:8000 (No Flask required!)")
    httpd.serve_forever()









