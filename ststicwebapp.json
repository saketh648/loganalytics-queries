import os
import sqlite3
import random
import json
import uuid
import urllib.parse
from http.server import HTTPServer, SimpleHTTPRequestHandler
from datetime import datetime

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_NAME = os.path.join(BASE_DIR, "dashboard.db")

# Active session tokens in memory: { session_cookie_id: username }
ACTIVE_SESSIONS = {}

class FormAuthHandler(SimpleHTTPRequestHandler):

    def get_session_user(self):
        # Extract cookie from request headers
        cookie_header = self.headers.get('Cookie')
        if cookie_header:
            cookies = dict(item.strip().split('=') for item in cookie_header.split(';') if '=' in item)
            session_id = cookies.get('session_id')
            return ACTIVE_SESSIONS.get(session_id)
        return None

    def do_GET(self):
        username = self.get_session_user()

        # If user is NOT logged in and trying to access protected routes, redirect to login page
        if not username and self.path not in ['/login.html', '/api/login']:
            self.send_response(302)
            self.send_header('Location', '/login.html')
            self.end_headers()
            return

        if self.path == '/api/metrics':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()

            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            cursor.execute('SELECT category, value, updated_at FROM metrics')
            rows = cursor.fetchall()
            conn.close()

            data = [{"category": row[0], "value": row[1], "updated_at": row[2]} for row in rows]
            response = {"timestamp": datetime.now().strftime("%I:%M:%S %p"), "data": data}
            self.wfile.write(json.dumps(response).encode('utf-8'))
        else:
            if self.path == '/':
                self.path = '/index.html'
            return super().do_GET()

    def do_POST(self):
        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length).decode('utf-8')

        if self.path == '/api/login':
            params = urllib.parse.parse_qs(body)
            username = params.get('username', [''])[0]
            password = params.get('password', [''])[0]

            # Simple credential check (or check against SQLite users table)
            if username == 'admin' and password == 'adminpassword':
                # Generate unique session ID
                session_id = str(uuid.uuid4())
                ACTIVE_SESSIONS[session_id] = username

                # Record login session in SQLite
                conn = sqlite3.connect(DB_NAME)
                cursor = conn.cursor()
                cursor.execute('INSERT INTO user_sessions (username) VALUES (?)', (username,))
                conn.commit()
                conn.close()

                # Send response with HTTP-Only Session Cookie
                self.send_response(200)
                self.send_header('Set-Cookie', f'session_id={session_id}; Path=/; HttpOnly')
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "success", "redirect": "/"}).encode('utf-8'))
            else:
                self.send_response(401)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"error": "Invalid username or password"}).encode('utf-8'))

        elif self.path == '/api/logout':
            cookie_header = self.headers.get('Cookie')
            if cookie_header:
                cookies = dict(item.strip().split('=') for item in cookie_header.split(';') if '=' in item)
                session_id = cookies.get('session_id')
                if session_id in ACTIVE_SESSIONS:
                    del ACTIVE_SESSIONS[session_id]

            # Clear cookie in browser
            self.send_response(200)
            self.send_header('Set-Cookie', 'session_id=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT')
            self.end_headers()
