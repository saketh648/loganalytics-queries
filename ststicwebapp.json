import sqlite3
import hashlib

DB_NAME = "dashboard.db"

def hash_password(password):
    return hashlib.sha256(password.encode('utf-8')).hexdigest()

def add_new_user(username, password):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    password_hash = hash_password(password)
    
    try:
        cursor.execute('INSERT INTO users (username, password_hash) VALUES (?, ?)', (username, password_hash))
        conn.commit()
        print(f"Successfully added user: {username}")
    except sqlite3.IntegrityError:
        print(f"Error: User '{username}' already exists!")
    finally:
        conn.close()

if __name__ == '__main__':
    # Enter the new username and password you want to create
    new_username = input("Enter new username: ")
    new_password = input("Enter new password: ")
    
    add_new_user(new_username, new_password)






def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    # ... (table creation SQL) ...

    # List of users to seed automatically
    initial_users = [
        ("admin", "adminpassword"),
        ("john_doe", "password123"),
        ("sarah_analytics", "securepass456")
    ]

    for username, password in initial_users:
        cursor.execute('SELECT COUNT(*) FROM users WHERE username = ?', (username,))
        if cursor.fetchone()[0] == 0:
            cursor.execute('INSERT INTO users (username, password_hash) VALUES (?, ?)', 
                           (username, hash_password(password)))
            print(f"Created user: {username}", flush=True)

    conn.commit()
    conn.close()
